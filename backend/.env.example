DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_SECRET=otra-clave-larga-distinta-para-firmar-los-jwt
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL como única fuente de verdad (desarrollo local o producción)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fosst_db
DB_CONN_MAX_AGE=600

# Redis para Celery y Caché
REDIS_URL=redis://127.0.0.1:6379/1

# Almacenamiento de objetos S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=fosst-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
STORAGE_BACKEND=storages.backends.s3.S3Storage

# Configuración centralizada de archivos
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# CORS y URLs de aplicación
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Correo electrónico y Notificaciones
RESEND_API_KEY=re_123456789
EMAIL_FROM=FOSST VIDA <no-reply@fosstvida.com>

# Servicio IA (Anthropic Claude / OpenAI / Local)
ANTHROPIC_API_KEY=tu-api-key-aqui
