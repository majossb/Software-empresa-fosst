DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_SECRET=otra-clave-larga-distinta-para-firmar-los-jwt
DEBUG=True
ENVIRONMENT=development
# Hosts permitidos. Para acceder por IP/LAN agrégalos aquí (ej: 192.168.1.50)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL como única fuente de verdad (desarrollo local o producción)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fosst_db
DB_CONN_MAX_AGE=600

# Redis para Celery y Caché
REDIS_URL=redis://127.0.0.1:6379/1

# Almacenamiento de objetos S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=fosst-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
STORAGE_BACKEND=storages.backends.s3.S3Storage
# En dev: dominio público para que las URLs de archivos abran en el navegador
# (si accedes por IP/LAN usa esa IP, ej: 192.168.1.50:9000/fosst-media).
# En producción usar el dominio/CDN real y AWS_QUERYSTRING_AUTH=True (privado).
AWS_S3_CUSTOM_DOMAIN=localhost:9000/fosst-media
AWS_S3_URL_PROTOCOL=http:
AWS_QUERYSTRING_AUTH=False

# Configuración centralizada de archivos
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/msword,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# CORS y URLs de aplicación
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Correo electrónico (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=FOSST VIDA <tu-correo@gmail.com>
SERVER_EMAIL=FOSST VIDA <tu-correo@gmail.com>

# ── Servicio IA (Google Gemini) ───────────────────────────────
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30
# Fallback local con Ollama (desactivado por defecto; requiere RAM suficiente)
OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=120
